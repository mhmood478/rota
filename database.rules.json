{
  "rules": {
    ".read": false,
    ".write": false,
    "rotas": {
      ".read": "auth != null",
      "$specialty": {
        ".write": "auth != null && root.child('editorAccess').child(auth.uid).child('enabled').val() === true && (root.child('editorAccess').child(auth.uid).child('specialty').val() === $specialty || root.child('editorAccess').child(auth.uid).child('specialty').val() === 'admin')"
      }
    },
    "editorAccess": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}